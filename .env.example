# =============================================================
# Earnings Call Sentiment Analyzer — Environment Variables
# Copy this file: cp .env.example .env
# Fill in your values. NEVER commit .env to git.
# =============================================================

# Hugging Face (optional — needed for gated models only)
HUGGINGFACE_TOKEN=your_token_here

# Alpha Vantage (optional — additional market data)
ALPHA_VANTAGE_API_KEY=your_key_here

# Finnhub (optional — financial news API)
FINNHUB_API_KEY=your_key_here

# Project paths (defaults work out of the box — do not change)
PROJECT_ROOT=.
DATA_DIR=./data
MODELS_DIR=./models
REPORTS_DIR=./reports
LOGS_DIR=./logs
